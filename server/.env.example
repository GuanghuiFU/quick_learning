# ---- DeepSeek LLM（结构化总结）----
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com

# ---- 千问 audio ASR（语音转写）----
ASR_PROVIDER=qwen-audio
ASR_MODEL=qwen-audio-3.0-asr-flash
ASR_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
ASR_API=sk-xxx

# ---- Obsidian 笔记输出 ----
VAULT_PATH=/path/to/your/ObsidianVault
NOTES_DIR=学习笔记
ATTACHMENTS_DIR=学习笔记/attachments

# ---- 字幕 OCR 裁剪带（画面高度比例，自顶向下）----
OCR_SUBTITLE_Y0=0.74
OCR_SUBTITLE_Y1=0.98

# ---- OCR 引擎：paddle(本地免费) / qwen-vl(云端效果好) ----
OCR_ENGINE=paddle

# ---- 关键画面评分权重（Score = w1*Svisual + w2*Socr + w3*Stranscript - w4*Sduplicate）----
SCORE_W1=0.3
SCORE_W2=0.3
SCORE_W3=0.3
SCORE_W4=0.3
SCORE_THRESHOLD=0.5

# ---- 视频下载 ----
DOWNLOAD_QUALITY=720
DOWNLOAD_METHOD=auto

# ---- 字幕策略 ----
SUBTITLE_SOURCE=auto        # auto(智能链) | bili | asr | ocr | off
SUBTITLE_AI_MIN_SEC=900     # 长视频阈值（秒），>15min 才考虑 AI 字幕
SUBTITLE_VERIFY=true        # 双维度校验 AI 字幕质量
SUBTITLE_TRUST_THRESHOLD=0.95  # 合格率阈值，>95% 大规模采用 AI 字幕
